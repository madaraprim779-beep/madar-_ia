<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>♤☯ MADARA IA ☯♧</title>

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <h1>♤☯ MADARA IA ☯♧</h1>

  <div id="chat">
    <div class="msg ia">
      Bonjour, je suis MADARA IA. Pose-moi une question.
    </div>
  </div>

  <div class="box">
    <input 
      id="message" 
      placeholder="Écris ton message..."
    >

    <button onclick="sendMessage()">
      Envoyer
    </button>
  </div>


<script>
async function sendMessage() {

  const input = document.getElementById("message");
  const chat = document.getElementById("chat");

  const text = input.value.trim();

  if (!text) return;


  chat.innerHTML += `
    <div class="msg user">
      ${text}
    </div>
  `;

  input.value = "";


  try {

    const response = await fetch("/api/chat", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        message: text
      })
    });


    const data = await response.json();


    chat.innerHTML += `
      <div class="msg ia">
        ${data.reply || "Erreur de réponse"}
      </div>
    `;


  } catch (error) {

    chat.innerHTML += `
      <div class="msg ia">
        Erreur de connexion au serveur
      </div>
    `;

  }


  chat.scrollTop = chat.scrollHeight;
}
</script>

</body>
</html>