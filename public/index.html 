<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>♤☯ MADARA IA ☯♧</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #111;
      color: white;
      display: flex;
      flex-direction: column;
      height: 100vh;
    }

    h1 {
      text-align: center;
      color: crimson;
    }

    #chat {
      flex: 1;
      overflow-y: auto;
      padding: 15px;
    }

    .msg {
      margin: 10px;
      padding: 10px;
      border-radius: 10px;
    }

    .user {
      background: #333;
      text-align: right;
    }

    .ia {
      background: #600;
    }

    .box {
      display: flex;
      padding: 10px;
    }

    input {
      flex: 1;
      padding: 12px;
      border-radius: 10px;
      border: none;
    }

    button {
      margin-left: 10px;
      padding: 12px;
      background: crimson;
      color: white;
      border: none;
      border-radius: 10px;
    }
  </style>
</head>

<body>

<h1>♤☯ MADARA IA ☯♧</h1>

<div id="chat"></div>

<div class="box">
  <input id="message" placeholder="Écris ton message...">
  <button onclick="send()">Envoyer</button>
</div>

<script>
async function send(){

  const input = document.getElementById("message");
  const chat = document.getElementById("chat");

  let message = input.value;

  if(!message) return;

  chat.innerHTML += `<div class="msg user">${message}</div>`;
  input.value = "";

  const res = await fetch("/api/chat", {
    method:"POST",
    headers:{
      "Content-Type":"application/json"
    },
    body: JSON.stringify({
      message: message
    })
  });

  const data = await res.json();

  chat.innerHTML += `<div class="msg ia">${data.reply || data.error}</div>`;

  chat.scrollTop = chat.scrollHeight;
}
</script>

</body>
</html>